{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/social-media",
      "destination": "/services/social-media",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
